//-----------------------------------------------------------------------------
//	VAUDIO_OPUS.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\..\.."
$Macro OUTBINDIR	"..\..\..\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories		"$BASE;..\frame_encoder;..\..\..\public;..\..\..\public\tier1;..\..;..\..\..\common;..\..\audio\public;.\;.\opus"
		$PreprocessorDefinitions			"$BASE;OPUS_EXPORTS"
	}
}

$Project "vaudio_opus"
{
	$Folder	"Source Files"
	{
		$File "$SRCDIR\tier1\interface.cpp"
		$File "..\frame_encoder\voice_codec_frame.cpp"
		$File "voiceencoder_opus.cpp"
	}

	$Folder	"Header Files"
	{
		$File	"$SRCDIR\public\tier1\interface.h"
		$File	"$SRCDIR\public\vaudio\ivaudio.h"
	}

	$Folder	"Link Libraries"
	{
		$Lib "$LIBCOMMON/libopus"
	}

}
