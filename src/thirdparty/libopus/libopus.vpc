$Macro SRCDIR "..\.."
$Macro OUTLIBDIR	"$LIBCOMMON"
$Include "$SRCDIR\vpc_scripts\source_lib_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories 	".\src;.\include;.\celt;.\silk;.\silk\float;.\silk\x86;.\celt\x86;.\"
		$PreprocessorDefinitions 	"$BASE;OPUS_STATIC_LIB;OPUS_BUILD;_CRT_SECURE_NO_WARNINGS;USE_ALLOCA;OPUS_X86_MAY_HAVE_SSE;OPUS_X86_MAY_HAVE_SSE2;ENABLE_QEXT;ENABLE_OPUS_CUSTOM_API;CUSTOM_MODES"
	}
	$Librarian
	{
	}
}

